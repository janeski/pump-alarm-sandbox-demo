<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>2593bb6b-be5d-467c-acd9-fd1da3d9e8ca</UserSecretsId>
    <!-- The OpenAI Responses API client is marked experimental in the OpenAI SDK. -->
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Local sandbox IDs; in Azure the settings come from environment variables. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <!-- Agent Governance Toolkit policy for run_python, read at startup. -->
    <None Update="governance\policy.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.AgentGovernance" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PumpAlarms.ServiceDefaults\PumpAlarms.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
